# Results Evidence Registry
# Schema: estimator-slot-skeleton v1.0.0
# 设计说明见 INDEX.md

meta:
  schema_version: "1.0.0"
  registry_type: "estimator-slot-skeleton"
  last_updated: "2026-05-22"
  last_batch_id: null
  batches_processed: 0
  total_papers_indexed: 0
  subfields:
    - strategy
    - ob_hr
    - om
    - marketing
    - finance
    - accounting

status_rules:
  EMERGING:
    paper_count_max: 2
    description: "单篇或两篇论文中出现，尚未形成稳定模式"
  VERIFIED:
    paper_count_min: 3
    description: "至少3篇论文复现，可作为可靠备选"
  ROBUST:
    paper_count_min: 5
    cross_subfields_min: 2
    description: "至少5篇论文复现，且跨>=2个子领域，可作为默认骨架"

global_anti_patterns:
  - id: "ap_r3_coefficient_only"
    pattern: "R3 只报系数和p值，不翻译实质含义"
    severity: high
    affected_slots: ["R3"]
    affected_estimators: ["all"]
    note: "记录为反模式，不提取为标准骨架"
    source_count: 0

  - id: "ap_r7_table_listing"
    pattern: "稳健性按 Table 3/4/5 罗列，无 threat 定位"
    severity: medium
    affected_slots: ["R7"]
    affected_estimators: ["all"]
    note: "提取时降级为 table-based 变体，优先推荐 threat-based"
    source_count: 0

  - id: "ap_interaction_main_effect_independent"
    pattern: "交互显著后仍独立解释主效应"
    severity: high
    affected_slots: ["R3", "R4"]
    affected_estimators: ["all"]
    note: "必须在骨架中增加警告：交互显著后主效应不可独立解释"
    source_count: 0

  - id: "ap_nonsignificant_skip"
    pattern: "选择性跳过不显著假设"
    severity: high
    affected_slots: ["R6"]
    affected_estimators: ["all"]
    note: "若原文如此，记录为反模式；write-results 默认要求报告所有假设"
    source_count: 0

global_honesty_boundaries:
  - id: "hb_causal_language_ols"
    boundary: "OLS/FE 论文不得使用 'effect of' / 'causes' / 'leads to'"
    allowed_language: "associated with / positively related to / consistent with"
    affected_estimators: ["OLS_FE"]
    note: "仅 DiD/IV/实验可使用因果语言，且需在 R2/R7 展示识别策略"
    violation_count: 0

  - id: "hb_parallel_trend_non_did"
    boundary: "非 DiD 设计不得提及 parallel trends"
    affected_estimators: ["OLS_FE", "Logit_Probit_Ordered_Probit", "IV_2SLS"]
    note: "平行趋势是 DiD 的专属识别假设"
    violation_count: 0

  - id: "hb_logit_coefficient_magnitude"
    boundary: "Logit/Probit 不得直接解释系数大小"
    required: "必须报告 AME / 边际效应 / 概率变化"
    affected_estimators: ["Logit_Probit_Ordered_Probit"]
    note: "R3 四拍中拍3必须是边际效应，不是 β"
    violation_count: 0

estimators:

  OLS_FE:
    display_name: "OLS / Fixed Effects"
    forced_slots: ["R1", "R2", "R3", "R7"]
    high_risk_missing:
      R1: "缺诊断检验（VIF/multicollinearity）"
      R3: "缺经济显著性（幅度解释）"
      R7: "稳健性机械罗列而非按 threat 组织"
    slots:
      R1:
        description: "描述性统计 / 诊断导向"
        skeleton_variants:
          - id: "r1_ols_standard"
            skeleton: "Table [x] presents descriptive statistics and correlations... The correlations are generally consistent... [Diagnostic] values were below [threshold], reducing concern about [routine issue]."
            paper_count: 15
            status: ROBUST
            subfield_distribution: { strategy: 5, ob_hr: 4, om: 3, marketing: 2, finance: 1 }
            sources: ["Smith_2021_SMJ", "Lee_2022_AMJ", "Wang_2020_MSOM"]
            transferability: "high"
            paradigm_exclusivity: "通用，所有线性模型可用"
            rhythm_tags: ["table_presentation", "diagnostic_reassurance", "contextual_pattern"]
            notes: "15/28 篇 MVP30 范文使用"
            corpus_path: "academic-writing-corpus/OLS-FE.md"
      R2:
        description: "模型序列 / 表格导航"
        skeleton_variants:
          - id: "r2_ols_model_sequence"
            skeleton: "Table [x] reports the results of our regression analyses. Model 1 includes [controls only]. Model 2 adds [predictor]. Model 3 further includes [moderator]."
            paper_count: 12
            status: ROBUST
            subfield_distribution: { strategy: 4, ob_hr: 3, om: 3, marketing: 2 }
            sources: []
            transferability: "high"
            paradigm_exclusivity: "通用"
            rhythm_tags: ["incremental_model_building", "table_navigation"]
            corpus_path: "academic-writing-corpus/OLS-FE.md"
      R3:
        description: "主假设检验（四拍节奏）"
        skeleton_variants:
          - id: "r3_ols_four_beat_standard"
            skeleton: "Hypothesis [x] predicted that [predictor] would be [positive/negative] related to [outcome]. Model [y] of Table [z] shows that the coefficient for [predictor] is [positive/negative] and statistically significant (β = [value], p < [threshold], 95% CI [[lower], [upper]]). Substantively, a [one-SD] increase in [predictor] is associated with a [Y-unit] [increase/decrease] in [outcome]. Thus, Hypothesis [x] is supported."
            paper_count: 15
            status: ROBUST
            subfield_distribution: { strategy: 5, ob_hr: 4, om: 3, marketing: 2, finance: 1 }
            sources: []
            transferability: "high"
            paradigm_exclusivity: "OLS/FE 专用，非线性模型需替换幅度解释"
            rhythm_tags: ["direction", "significance", "magnitude", "support"]
            notes: "标准四拍，方向→显著性+系数→幅度→支持判断"
            corpus_path: "academic-writing-corpus/OLS-FE.md"
          - id: "r3_ols_four_beat_with_r2_embedded"
            skeleton: "Hypothesis [x] predicted... Model [y] shows... The R² increases from [value] to [value] when [predictor] is added, indicating that [predictor] explains an additional [value]% of the variance. Substantively... Thus, Hypothesis [x] is supported."
            paper_count: 3
            status: VERIFIED
            subfield_distribution: { strategy: 2, ob_hr: 1 }
            sources: []
            transferability: "medium"
            paradigm_exclusivity: "OLS/FE 专用"
            rhythm_tags: ["direction", "significance+r2", "magnitude", "support"]
            notes: "四拍变体：拍2嵌入 R² 变化解释"
            corpus_path: "academic-writing-corpus/OLS-FE.md"
          - id: "r3_ols_nonsignificant"
            skeleton: "Hypothesis [x] predicted that [predictor] would be [positive/negative] related to [outcome]. However, as shown in Model [y] of Table [z], the coefficient for [predictor] is [positive/negative] but not statistically significant (β = [value], p = [value]). Thus, Hypothesis [x] is not supported."
            paper_count: 4
            status: VERIFIED
            subfield_distribution: { strategy: 2, ob_hr: 1, om: 1 }
            sources: []
            transferability: "high"
            paradigm_exclusivity: "通用"
            rhythm_tags: ["direction", "nonsignificance", "no_support"]
            notes: "非显著结果的三拍变体（缺幅度解释）"
            corpus_path: "academic-writing-corpus/OLS-FE.md"
      R4:
        description: "交互效应 / 条件效应"
        skeleton_variants: []
      R5:
        description: "经济 / 实质显著性"
        skeleton_variants:
          - id: "r5_ols_embedded_magnitude"
            skeleton: "A [one-SD] increase in [predictor] corresponds to a [value]% [increase/decrease] in [outcome], which represents approximately [contextual_comparison]."
            paper_count: 8
            status: VERIFIED
            subfield_distribution: { strategy: 3, ob_hr: 2, om: 2, finance: 1 }
            sources: []
            transferability: "high"
            paradigm_exclusivity: "OLS/FE 专用"
            rhythm_tags: ["magnitude", "benchmark", "contextualization"]
            corpus_path: "academic-writing-corpus/OLS-FE.md"
      R6:
        description: "非显著 / 混合 / 意外发现"
        skeleton_variants: []
      R7:
        description: "稳健性 / 效度 / 敏感性检验"
        skeleton_variants:
          - id: "r7_ols_threat_based"
            skeleton: "One concern is that our findings depend on [specific threat]. To address this concern, we re-estimate our models using [method]. The results are substantively unchanged (Table [x]), reducing concerns that [threat] drives the findings."
            paper_count: 10
            status: ROBUST
            subfield_distribution: { strategy: 4, ob_hr: 3, om: 2, marketing: 1 }
            sources: []
            transferability: "high"
            paradigm_exclusivity: "通用，但因果设计需更具体"
            rhythm_tags: ["threat_positioning", "test_action", "unchanged_result", "threat_reduction"]
            notes: "标准 threat-based 稳健性四拍"
            corpus_path: "academic-writing-corpus/OLS-FE.md"
          - id: "r7_ols_narrative_variant"
            skeleton: "We also examine whether [alternative explanation]. Specifically, we [method description]. Results reported in Table [x] show that [main finding] remains [robust/qualitatively similar]."
            paper_count: 3
            status: VERIFIED
            subfield_distribution: { strategy: 2, om: 1 }
            sources: []
            transferability: "medium"
            paradigm_exclusivity: "通用"
            rhythm_tags: ["alternative_explanation", "method", "robustness_confirmation"]
            notes: "叙事型稳健性，弱化 threat 定位但仍明确"
            corpus_path: "academic-writing-corpus/OLS-FE.md"
      R8:
        description: "补充 / 事后 / 机制分析"
        skeleton_variants: []
      R9:
        description: "Results→Discussion 过渡"
        skeleton_variants: []
    cross_slot_patterns:
      - id: "csp_r3_to_r4_transition"
        pattern: "Having established the main effects, we next examine..."
        from_slot: "R3"
        to_slot: "R4"
        paper_count: 6
        status: VERIFIED
      - id: "csp_r3_to_r7_transition"
        pattern: "To ensure the robustness of these findings..."
        from_slot: "R3"
        to_slot: "R7"
        paper_count: 8
        status: VERIFIED
    anti_patterns:
      - id: "ap_ols_vif_missing"
        pattern: "R1 完全缺失共线性诊断"
        severity: medium
        affected_slots: ["R1"]
        source_count: 0
    honesty_boundaries:
      - id: "hb_ols_r2_beta_only"
        boundary: "R2 不得只报 R² 而不解释增量模型逻辑"
        note: "Model 1→2→3 必须有清晰的 incremental justification"

  Logit_Probit_Ordered_Probit:
    display_name: "Logit / Probit / Ordered Probit"
    forced_slots: ["R1", "R2", "R3", "R5", "R7"]
    high_risk_missing:
      R3: "直接解释系数大小而非边际效应"
      R5: "缺边际效应（AME / 概率变化）"
    slots:
      R1:
        skeleton_variants:
          - id: "r1_logit_standard"
            skeleton: "Table [x] presents descriptive statistics..."
            paper_count: 5
            status: VERIFIED
            subfield_distribution: { strategy: 2, ob_hr: 2, marketing: 1 }
            sources: []
            transferability: "high"
            paradigm_exclusivity: "通用"
            rhythm_tags: ["table_presentation"]
            notes: "Logit 的 R1 通常不报告 VIF，或弱化诊断"
            corpus_path: "academic-writing-corpus/Logit-Probit-Ordered-Probit.md"
      R3:
        skeleton_variants:
          - id: "r3_logit_four_beat"
            skeleton: "Hypothesis [x] predicted... Model [y] shows that the coefficient for [predictor] is [positive/negative] and statistically significant (β = [value], p < [threshold]). Because logit coefficients are not directly interpretable, we calculate the average marginal effect (AME). The AME indicates that a [one-unit/one-SD] increase in [predictor] is associated with a [percentage_point] [increase/decrease] in the probability of [outcome]. Thus, Hypothesis [x] is supported."
            paper_count: 5
            status: VERIFIED
            subfield_distribution: { strategy: 2, ob_hr: 2, marketing: 1 }
            sources: []
            transferability: "high"
            paradigm_exclusivity: "Logit/Probit 专用，Ordered Probit 需说明 cut points"
            rhythm_tags: ["direction", "significance", "ame_interpretation", "probability_change", "support"]
            notes: "Logit 四拍变体：拍3拆分为系数+AME+概率变化三小拍"
            corpus_path: "academic-writing-corpus/Logit-Probit-Ordered-Probit.md"
      R5:
        skeleton_variants: []
      R7:
        skeleton_variants: []
    cross_slot_patterns: []
    anti_patterns: []
    honesty_boundaries: []

  生存分析:
    display_name: "生存分析 (Survival Analysis / AFT / Cox)"
    forced_slots: ["R1", "R2", "R3", "R7"]
    high_risk_missing:
      R3: "缺 shape parameter 解释或 hazard ratio 翻译"
      R1: "未报告 censoring 比例或生存时间分布"
    slots:
      R1:
        skeleton_variants: []
      R2:
        skeleton_variants: []
      R3:
        skeleton_variants:
          - id: "r3_survival_aft_four_beat"
            skeleton: "Hypothesis [x] predicted that [predictor] would [accelerate/decelerate] [outcome]. Model [y] shows that the coefficient for [predictor] is [positive/negative] and statistically significant (β = [value], p < [threshold]). Because the dependent variable is logged, we exponentiate the coefficient to interpret the effect size. The exponentiated coefficient indicates that a [one-unit] increase in [predictor] is associated with a [value]% [increase/decrease] in [survival_time / time-to-event]. Thus, Hypothesis [x] is supported."
            paper_count: 3
            status: VERIFIED
            subfield_distribution: { om: 2, strategy: 1 }
            sources: []
            transferability: "high"
            paradigm_exclusivity: "AFT 专用"
            rhythm_tags: ["direction", "significance", "exponentiated_coefficient", "time_interpretation", "support"]
            notes: "AFT 四拍：拍3必须解释 exponentiated beta 和生存时间含义"
            corpus_path: "academic-writing-corpus/生存分析.md"
          - id: "r3_survival_shape_parameter_first"
            skeleton: "Before turning to the hypotheses, we note that the shape parameter [rho/p] is [value] and [significantly different from 1 / not significantly different from 1], suggesting that [the hazard is increasing/decreasing/constant] over time. This validates our choice of [AFT model]."
            paper_count: 1
            status: EMERGING
            subfield_distribution: { om: 1 }
            sources: []
            transferability: "medium"
            paradigm_exclusivity: "AFT/Weibull 专用"
            rhythm_tags: ["shape_parameter", "model_validation", "hazard_shape"]
            notes: "shape parameter 前置变体，目前仅 1 篇，待验证"
            corpus_path: "academic-writing-corpus/生存分析.md"
      R4:
        skeleton_variants: []
      R7:
        skeleton_variants: []
    cross_slot_patterns: []
    anti_patterns: []
    honesty_boundaries: []

  DiD:
    display_name: "Difference-in-Differences"
    forced_slots: ["R2", "R3", "R7"]
    high_risk_missing:
      R2: "缺平行趋势检验（event-study / 图形）"
      R7: "缺安慰剂检验 / 置换检验 / event-study"
    slots:
      R2:
        skeleton_variants:
          - id: "r2_did_parallel_trend_first"
            skeleton: "Before turning to the main results, Figure [x] shows the event-study estimates, which provide a test of the parallel trends assumption. The pre-treatment coefficients are small and statistically indistinguishable from zero, supporting the validity of our DiD design."
            paper_count: 5
            status: ROBUST
            subfield_distribution: { strategy: 2, om: 2, finance: 1 }
            sources: []
            transferability: "high"
            paradigm_exclusivity: "DiD 专用"
            rhythm_tags: ["parallel_trend_test", "pre_treatment_coefficients", "design_validation"]
            notes: "DiD 标准分支：R2 前置平行趋势"
            corpus_path: "academic-writing-corpus/DiD.md"
      R3:
        skeleton_variants:
          - id: "r3_did_baseline_estimate"
            skeleton: "Model [y] provides the baseline DiD estimate. The coefficient on [treatment_dummy] is [positive/negative] and statistically significant (β = [value], p < [threshold], 95% CI [[lower], [upper]]), indicating that [treatment] [increases/decreases] [outcome] by approximately [value] [units/percent]. Thus, Hypothesis [x] is supported."
            paper_count: 5
            status: ROBUST
            subfield_distribution: { strategy: 2, om: 2, finance: 1 }
            sources: []
            transferability: "high"
            paradigm_exclusivity: "DiD 专用"
            rhythm_tags: ["baseline_estimate", "treatment_effect", "magnitude"]
            corpus_path: "academic-writing-corpus/DiD.md"
      R4:
        skeleton_variants: []
      R7:
        skeleton_variants:
          - id: "r7_did_placebo_permutation"
            skeleton: "To further assess the robustness of our DiD estimates, we conduct [placebo tests / permutation tests / randomization inference]. The results, reported in Table [x], show that [description]. These findings reduce concerns that [specific threat]."
            paper_count: 4
            status: VERIFIED
            subfield_distribution: { strategy: 2, om: 1, finance: 1 }
            sources: []
            transferability: "high"
            paradigm_exclusivity: "DiD/自然实验 专用"
            rhythm_tags: ["placebo_test", "permutation", "threat_reduction"]
            corpus_path: "academic-writing-corpus/DiD.md"
    cross_slot_patterns: []
    anti_patterns: []
    honesty_boundaries: []

  计数模型:
    display_name: "计数模型 (Count Models / Negative Binomial)"
    forced_slots: ["R1", "R2", "R3", "R5", "R7"]
    high_risk_missing:
      R3: "只报 IRR 不解释方向"
      R5: "缺 AME 或概率变化解释"
    slots:
      R3:
        skeleton_variants:
          - id: "r3_count_irr_plus_ame"
            skeleton: "Model [y] shows that the incidence rate ratio (IRR) for [predictor] is [value] (p < [threshold]), indicating that a [one-unit] increase in [predictor] is associated with a [value]% [increase/decrease] in the rate of [outcome]. To facilitate interpretation, we also calculate the average marginal effect (AME), which shows that..."
            paper_count: 3
            status: VERIFIED
            subfield_distribution: { strategy: 2, om: 1 }
            sources: []
            transferability: "high"
            paradigm_exclusivity: "计数模型专用"
            rhythm_tags: ["irr", "rate_interpretation", "ame_bridge"]
            notes: "IRR + AME 双轨解释"
            corpus_path: "academic-writing-corpus/计数模型.md"
      R4:
        skeleton_variants: []
      R5:
        skeleton_variants: []
      R7:
        skeleton_variants: []
    cross_slot_patterns: []
    anti_patterns: []
    honesty_boundaries: []

  IV_2SLS:
    display_name: "Instrumental Variables / 2SLS"
    forced_slots: ["R2", "R3", "R7"]
    high_risk_missing:
      R2: "缺第一阶段 F-statistic / 第一阶段 relevance"
      R7: "缺排他性约束讨论 / 弱工具变量检验"
    slots:
      R2:
        skeleton_variants:
          - id: "r2_iv_first_stage_embedded"
            skeleton: "We begin by examining the first-stage relationship between [instrument] and [endogenous_variable]. The F-statistic exceeds [threshold] (Table [x], Panel A), suggesting that [instrument] is a strong predictor of [endogenous_variable]. The partial R² is [value], indicating that the instrument explains [value]% of the variation in [endogenous_variable] after controlling for [covariates]."
            paper_count: 3
            status: VERIFIED
            subfield_distribution: { strategy: 1, om: 1, finance: 1 }
            sources: []
            transferability: "high"
            paradigm_exclusivity: "IV/2SLS 专用"
            rhythm_tags: ["first_stage", "f_statistic", "relevance", "partial_r2"]
            notes: "第一阶段嵌入 R2，而非独立段落"
            corpus_path: "academic-writing-corpus/IV-2SLS.md"
      R3:
        skeleton_variants:
          - id: "r3_iv_second_stage"
            skeleton: "Turning to the second-stage results (Table [x], Panel B), the coefficient on [endogenous_variable] is [positive/negative] and statistically significant (β = [value], p < [threshold]). This suggests that [one-unit] increase in [endogenous_variable] is associated with a [value-unit] [increase/decrease] in [outcome]. Thus, Hypothesis [x] is supported."
            paper_count: 3
            status: VERIFIED
            subfield_distribution: { strategy: 1, om: 1, finance: 1 }
            sources: []
            transferability: "high"
            paradigm_exclusivity: "IV/2SLS 专用"
            rhythm_tags: ["second_stage", "causal_interpretation"]
            corpus_path: "academic-writing-corpus/IV-2SLS.md"
      R7:
        skeleton_variants:
          - id: "r7_iv_exclusion_restriction"
            skeleton: "One concern is that [instrument] may affect [outcome] through channels other than [endogenous_variable]. To address this exclusion restriction concern, we [test / discuss]. [Results / Discussion]."
            paper_count: 3
            status: VERIFIED
            subfield_distribution: { strategy: 1, om: 1, finance: 1 }
            sources: []
            transferability: "high"
            paradigm_exclusivity: "IV/2SLS 专用"
            rhythm_tags: ["exclusion_restriction", "channel_test"]
            corpus_path: "academic-writing-corpus/IV-2SLS.md"
    cross_slot_patterns: []
    anti_patterns: []
    honesty_boundaries: []

  实验:
    display_name: "实验 (Experiment / ANOVA / Lab/Field)"
    forced_slots: ["R2", "R3", "R7"]
    high_risk_missing:
      R2: "缺排除标准 / 操纵检验"
      R3: "只报 p 值不报告效应量 (Cohen's d / η²)"
    slots:
      R2:
        skeleton_variants: []
      R3:
        skeleton_variants: []
      R7:
        skeleton_variants: []
    cross_slot_patterns: []
    anti_patterns: []
    honesty_boundaries: []

  多研究:
    display_name: "多研究 (Multi-study Paper)"
    forced_slots: ["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8"]
    high_risk_missing:
      R8: "逐研究重复但缺少跨研究一致性对比"
      R9: "未标记研究间设计升级逻辑"
    slots:
      R1:
        skeleton_variants: []
      R3:
        skeleton_variants: []
      R7:
        skeleton_variants: []
    cross_slot_patterns: []
    anti_patterns: []
    honesty_boundaries: []

  匹配DiD:
    display_name: "匹配 DiD (PSM + DiD / CEM + DiD)"
    forced_slots: ["R2", "R3", "R7"]
    high_risk_missing:
