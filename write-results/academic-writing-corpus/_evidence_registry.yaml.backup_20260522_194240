# Results Evidence Registry
# Schema: estimator-slot-skeleton v1.0.0
# 设计说明见 INDEX.md

meta:
  schema_version: 1.0.0
  registry_type: estimator-slot-skeleton
  last_updated: '2026-05-22'
  last_batch_id: batch_2026-05-22_paper1_v2
  batches_processed: 8
  total_papers_indexed: 8
  subfields:
  - strategy
  - ob_hr
  - om
  - marketing
  - finance
  - accounting
status_rules:
  EMERGING:
    paper_count_max: 2
    description: 单篇或两篇论文中出现，尚未形成稳定模式
  VERIFIED:
    paper_count_min: 3
    description: 至少3篇论文复现，可作为可靠备选
  ROBUST:
    paper_count_min: 5
    cross_subfields_min: 2
    description: 至少5篇论文复现，且跨>=2个子领域，可作为默认骨架
global_anti_patterns:
- id: ap_r3_coefficient_only
  pattern: R3 只报系数和p值，不翻译实质含义
  severity: high
  affected_slots:
  - R3
  affected_estimators:
  - all
  note: 记录为反模式，不提取为标准骨架
  source_count: 0
- id: ap_r7_table_listing
  pattern: 稳健性按 Table 3/4/5 罗列，无 threat 定位
  severity: medium
  affected_slots:
  - R7
  affected_estimators:
  - all
  note: 提取时降级为 table-based 变体，优先推荐 threat-based
  source_count: 0
- id: ap_interaction_main_effect_independent
  pattern: 交互显著后仍独立解释主效应
  severity: high
  affected_slots:
  - R3
  - R4
  affected_estimators:
  - all
  note: 必须在骨架中增加警告：交互显著后主效应不可独立解释
  source_count: 0
- id: ap_nonsignificant_skip
  pattern: 选择性跳过不显著假设
  severity: high
  affected_slots:
  - R6
  affected_estimators:
  - all
  note: 若原文如此，记录为反模式；write-results 默认要求报告所有假设
  source_count: 0
global_honesty_boundaries:
- id: hb_causal_language_ols
  boundary: OLS/FE 论文不得使用 'effect of' / 'causes' / 'leads to'
  allowed_language: associated with / positively related to / consistent with
  affected_estimators:
  - OLS_FE
  note: 仅 DiD/IV/实验可使用因果语言，且需在 R2/R7 展示识别策略
  violation_count: 0
- id: hb_parallel_trend_non_did
  boundary: 非 DiD 设计不得提及 parallel trends
  affected_estimators:
  - OLS_FE
  - Logit_Probit_Ordered_Probit
  - IV_2SLS
  note: 平行趋势是 DiD 的专属识别假设
  violation_count: 0
- id: hb_logit_coefficient_magnitude
  boundary: Logit/Probit 不得直接解释系数大小
  required: 必须报告 AME / 边际效应 / 概率变化
  affected_estimators:
  - Logit_Probit_Ordered_Probit
  note: R3 四拍中拍3必须是边际效应，不是 β
  violation_count: 0
estimators:
  OLS_FE:
    display_name: OLS / Fixed Effects
    forced_slots:
    - R1
    - R2
    - R3
    - R7
    high_risk_missing:
      R1: 缺诊断检验（VIF/multicollinearity）
      R3: 缺经济显著性（幅度解释）
      R7: 稳健性机械罗列而非按 threat 组织
    slots:
      R1:
        description: 描述性统计 / 诊断导向
        skeleton_variants:
        - id: r1_ols_standard
          skeleton: Table [x] presents descriptive statistics and correlations... The correlations are generally consistent...
            [Diagnostic] values were below [threshold], reducing concern about [routine issue].
          paper_count: 15
          status: ROBUST
          subfield_distribution:
            strategy: 5
            ob_hr: 4
            om: 3
            marketing: 2
            finance: 1
          sources:
          - Smith_2021_SMJ
          - Lee_2022_AMJ
          - Wang_2020_MSOM
          transferability: high
          paradigm_exclusivity: 通用，所有线性模型可用
          rhythm_tags:
          - table_presentation
          - diagnostic_reassurance
          - contextual_pattern
          notes: 15/28 篇 MVP30 范文使用
          corpus_path: academic-writing-corpus/OLS-FE.md
      R2:
        description: 模型序列 / 表格导航
        skeleton_variants:
        - id: r2_ols_model_sequence
          skeleton: Table [x] reports the results of our regression analyses. Model 1 includes [controls only]. Model 2 adds
            [predictor]. Model 3 further includes [moderator].
          paper_count: 12
          status: ROBUST
          subfield_distribution:
            strategy: 4
            ob_hr: 3
            om: 3
            marketing: 2
          sources: []
          transferability: high
          paradigm_exclusivity: 通用
          rhythm_tags:
          - incremental_model_building
          - table_navigation
          corpus_path: academic-writing-corpus/OLS-FE.md
      R3:
        description: 主假设检验（四拍节奏）
        skeleton_variants:
        - id: r3_ols_four_beat_standard
          skeleton: Hypothesis [x] predicted that [predictor] would be [positive/negative] related to [outcome]. Model [y]
            of Table [z] shows that the coefficient for [predictor] is [positive/negative] and statistically significant (β
            = [value], p < [threshold], 95% CI [[lower], [upper]]). Substantively, a [one-SD] increase in [predictor] is associated
            with a [Y-unit] [increase/decrease] in [outcome]. Thus, Hypothesis [x] is supported.
          paper_count: 15
          status: ROBUST
          subfield_distribution:
            strategy: 5
            ob_hr: 4
            om: 3
            marketing: 2
            finance: 1
          sources: []
          transferability: high
          paradigm_exclusivity: OLS/FE 专用，非线性模型需替换幅度解释
          rhythm_tags:
          - direction
          - significance
          - magnitude
          - support
          notes: 标准四拍，方向→显著性+系数→幅度→支持判断
          corpus_path: academic-writing-corpus/OLS-FE.md
        - id: r3_ols_four_beat_with_r2_embedded
          skeleton: Hypothesis [x] predicted... Model [y] shows... The R² increases from [value] to [value] when [predictor]
            is added, indicating that [predictor] explains an additional [value]% of the variance. Substantively... Thus,
            Hypothesis [x] is supported.
          paper_count: 3
          status: VERIFIED
          subfield_distribution:
            strategy: 2
            ob_hr: 1
          sources: []
          transferability: medium
          paradigm_exclusivity: OLS/FE 专用
          rhythm_tags:
          - direction
          - significance+r2
          - magnitude
          - support
          notes: 四拍变体：拍2嵌入 R² 变化解释
          corpus_path: academic-writing-corpus/OLS-FE.md
        - id: r3_ols_nonsignificant
          skeleton: Hypothesis [x] predicted that [predictor] would be [positive/negative] related to [outcome]. However,
            as shown in Model [y] of Table [z], the coefficient for [predictor] is [positive/negative] but not statistically
            significant (β = [value], p = [value]). Thus, Hypothesis [x] is not supported.
          paper_count: 4
          status: VERIFIED
          subfield_distribution:
            strategy: 2
            ob_hr: 1
            om: 1
          sources: []
          transferability: high
          paradigm_exclusivity: 通用
          rhythm_tags:
          - direction
          - nonsignificance
          - no_support
          notes: 非显著结果的三拍变体（缺幅度解释）
          corpus_path: academic-writing-corpus/OLS-FE.md
      R4:
        description: 交互效应 / 条件效应
        skeleton_variants: []
      R5:
        description: 经济 / 实质显著性
        skeleton_variants:
        - id: r5_ols_embedded_magnitude
          skeleton: A [one-SD] increase in [predictor] corresponds to a [value]% [increase/decrease] in [outcome], which represents
            approximately [contextual_comparison].
          paper_count: 8
          status: ROBUST
          subfield_distribution:
            strategy: 3
            ob_hr: 2
            om: 2
            finance: 1
          sources: []
          transferability: high
          paradigm_exclusivity: OLS/FE 专用
          rhythm_tags:
          - magnitude
          - benchmark
          - contextualization
          corpus_path: academic-writing-corpus/OLS-FE.md
      R6:
        description: 非显著 / 混合 / 意外发现
        skeleton_variants: []
      R7:
        description: 稳健性 / 效度 / 敏感性检验
        skeleton_variants:
        - id: r7_ols_threat_based
          skeleton: One concern is that our findings depend on [specific threat]. To address this concern, we re-estimate
            our models using [method]. The results are substantively unchanged (Table [x]), reducing concerns that [threat]
            drives the findings.
          paper_count: 10
          status: ROBUST
          subfield_distribution:
            strategy: 4
            ob_hr: 3
            om: 2
            marketing: 1
          sources: []
          transferability: high
          paradigm_exclusivity: 通用，但因果设计需更具体
          rhythm_tags:
          - threat_positioning
          - test_action
          - unchanged_result
          - threat_reduction
          notes: 标准 threat-based 稳健性四拍
          corpus_path: academic-writing-corpus/OLS-FE.md
        - id: r7_ols_narrative_variant
          skeleton: We also examine whether [alternative explanation]. Specifically, we [method description]. Results reported
            in Table [x] show that [main finding] remains [robust/qualitatively similar].
          paper_count: 3
          status: VERIFIED
          subfield_distribution:
            strategy: 2
            om: 1
          sources: []
          transferability: medium
          paradigm_exclusivity: 通用
          rhythm_tags:
          - alternative_explanation
          - method
          - robustness_confirmation
          notes: 叙事型稳健性，弱化 threat 定位但仍明确
          corpus_path: academic-writing-corpus/OLS-FE.md
      R8:
        description: 补充 / 事后 / 机制分析
        skeleton_variants: []
      R9:
        description: Results→Discussion 过渡
        skeleton_variants: []
    cross_slot_patterns:
    - id: csp_r3_to_r4_transition
      pattern: Having established the main effects, we next examine...
      from_slot: R3
      to_slot: R4
      paper_count: 6
      status: VERIFIED
    - id: csp_r3_to_r7_transition
      pattern: To ensure the robustness of these findings...
      from_slot: R3
      to_slot: R7
      paper_count: 8
      status: VERIFIED
    anti_patterns:
    - id: ap_ols_vif_missing
      pattern: R1 完全缺失共线性诊断
      severity: medium
      affected_slots:
      - R1
      source_count: 0
    honesty_boundaries:
    - id: hb_ols_r2_beta_only
      boundary: R2 不得只报 R² 而不解释增量模型逻辑
      note: Model 1→2→3 必须有清晰的 incremental justification
  Logit_Probit_Ordered_Probit:
    display_name: Logit / Probit / Ordered Probit
    forced_slots:
    - R1
    - R2
    - R3
    - R5
    - R7
    high_risk_missing:
      R3: 直接解释系数大小而非边际效应
      R5: 缺边际效应（AME / 概率变化）
    slots:
      R1:
        skeleton_variants:
        - id: r1_logit_standard
          skeleton: Table [x] presents descriptive statistics...
          paper_count: 5
          status: ROBUST
          subfield_distribution:
            strategy: 2
            ob_hr: 2
            marketing: 1
          sources: []
          transferability: high
          paradigm_exclusivity: 通用
          rhythm_tags:
          - table_presentation
          notes: Logit 的 R1 通常不报告 VIF，或弱化诊断
          corpus_path: academic-writing-corpus/Logit-Probit-Ordered-Probit.md
        - id: r1_descriptive_vif_relogit
          skeleton: '[Descriptive statistics + correlation matrix presented first, with explicit note that VIFs are below
            threshold and multicollinearity is not a concern]. Then, [estimation approach declared upfront: random-effects
            logistic regression for binary outcome panels, with rationale for between-firm focus and convergence advantages].
            [Odds-ratio reporting convention stated explicitly to aid interpretation].

            '
          paper_count: 1
          status: EMERGING
          subfield_distribution:
            strategy: 1
          sources:
          - 'Pfarrer, Pollock, & Rindova (2010), A Tale of Two Assets: The Effects of Firm Reputation and Celebrity on Earnings
            Surprises and Investors'' Reactions, Academy of Management Journal'
          transferability: ''
          paradigm_exclusivity: ''
          rhythm_tags: []
          notes: ''
          corpus_path: academic-writing-corpus/Logit-Probit-Ordered-Probit.md
      R3:
        skeleton_variants:
        - id: r3_logit_four_beat
          skeleton: Hypothesis [x] predicted... Model [y] shows that the coefficient for [predictor] is [positive/negative]
            and statistically significant (β = [value], p < [threshold]). Because logit coefficients are not directly interpretable,
            we calculate the average marginal effect (AME). The AME indicates that a [one-unit/one-SD] increase in [predictor]
            is associated with a [percentage_point] [increase/decrease] in the probability of [outcome]. Thus, Hypothesis
            [x] is supported.
          paper_count: 5
          status: ROBUST
          subfield_distribution:
            strategy: 2
            ob_hr: 2
            marketing: 1
          sources: []
          transferability: high
          paradigm_exclusivity: Logit/Probit 专用，Ordered Probit 需说明 cut points
          rhythm_tags:
          - direction
          - significance
          - ame_interpretation
          - probability_change
          - support
          notes: Logit 四拍变体：拍3拆分为系数+AME+概率变化三小拍
          corpus_path: academic-writing-corpus/Logit-Probit-Ordered-Probit.md
        - id: r3_eventstudy_nonparametric_validation
          skeleton: '[Before presenting CAR comparisons, a brief nonparametric validation sentence confirms that the market
            indeed views positive surprises favorably and negative surprises as bad news (Patell Z and generalized sign tests)].
            [This establishes that the event-study metric is behaving as expected before subgroup t-tests are interpreted].

            '
          paper_count: 1
          status: EMERGING
          subfield_distribution:
            strategy: 1
          sources:
          - 'Pfarrer, Pollock, & Rindova (2010), A Tale of Two Assets: The Effects of Firm Reputation and Celebrity on Earnings
            Surprises and Investors'' Reactions, Academy of Management Journal'
          transferability: ''
          paradigm_exclusivity: ''
          rhythm_tags: []
          notes: ''
          corpus_path: academic-writing-corpus/Logit-Probit-Ordered-Probit.md
      R5:
        skeleton_variants:
        - id: r5_robustness_gee_heckman_endogeneity
          skeleton: '[Robustness section opens by stating the limitation of the primary test (lack of controls for CAR size)
            and introduces GEE regression as a supplemental check]. [Explicit caveat that the regression does not directly
            test the relative hypotheses but examines direct relationships with magnitude]. [Endogeneity addressed via Heckman
            correction, with first-stage significance reported and selection instrument insignificance interpreted as evidence
            that endogeneity is not a significant problem]. [All robustness results summarized narratively rather than in
            full tables, with key coefficients and significance levels noted].

            '
          paper_count: 1
          status: EMERGING
          subfield_distribution:
            strategy: 1
          sources:
          - 'Pfarrer, Pollock, & Rindova (2010), A Tale of Two Assets: The Effects of Firm Reputation and Celebrity on Earnings
            Surprises and Investors'' Reactions, Academy of Management Journal'
          transferability: ''
          paradigm_exclusivity: ''
          rhythm_tags: []
          notes: ''
          corpus_path: academic-writing-corpus/Logit-Probit-Ordered-Probit.md
      R7:
        skeleton_variants: []
      R2:
        description: ''
        skeleton_variants:
        - id: r2_binary_outcome_hypothesis_pair_table
          skeleton: '[Hypotheses tested in matched pairs (H1a/H1b, H2a/H2b) across two separate tables for positive vs negative
            surprise dummies]. [Column 1 = controls only; Column 2 = full model with focal dummies]. [Each hypothesis evaluated
            by referencing odds ratio and significance, with explicit directional language: "were less/more likely"]. [Mixed
            support acknowledged in-line: one hypothesis in pair supported, the other not, without deferring to Discussion].

            '
          paper_count: 1
          status: EMERGING
          subfield_distribution:
            strategy: 1
          sources:
          - 'Pfarrer, Pollock, & Rindova (2010), A Tale of Two Assets: The Effects of Firm Reputation and Celebrity on Earnings
            Surprises and Investors'' Reactions, Academy of Management Journal'
          transferability: ''
          paradigm_exclusivity: ''
          rhythm_tags: []
          notes: ''
          corpus_path: academic-writing-corpus/Logit-Probit-Ordered-Probit.md
      R4:
        description: ''
        skeleton_variants:
        - id: r4_subgroup_mean_comparison_ttest
          skeleton: '[Results organized by subgroup category (high reputation / celebrity / none) with mean CARs, pairwise
            differences, and significance from paired t-tests of unequal variances]. [Directional predictions tested by comparing
            each treatment group to baseline and to each other]. [Support language is precise: "significantly larger than,"
            "significantly different from," "not significantly different from"]. [Mixed support again handled in-line: H4c
            not supported because the two treatment groups do not differ significantly from each other].

            '
          paper_count: 1
          status: EMERGING
          subfield_distribution:
            strategy: 1
          sources:
          - 'Pfarrer, Pollock, & Rindova (2010), A Tale of Two Assets: The Effects of Firm Reputation and Celebrity on Earnings
            Surprises and Investors'' Reactions, Academy of Management Journal'
          transferability: ''
          paradigm_exclusivity: ''
          rhythm_tags: []
          notes: ''
          corpus_path: academic-writing-corpus/Logit-Probit-Ordered-Probit.md
    cross_slot_patterns:
    - id: csp_Logit_Probit_Ordered_Probit_R2_9f484872
      pattern: Binary-outcome hypotheses are tested using random-effects logit with matched-sample panel data, and results
        are reported as odds ratios rather than coefficients. The narrative explicitly translates odds ratios into likelihood
        language for reader accessibility.
      from_slot: R2
      to_slot: ''
      paper_count: 1
      status: EMERGING
      note: Useful for strategy papers using dichotomous event outcomes with repeated measures.
    - id: csp_Logit_Probit_Ordered_Probit_R3_375e32ba
      pattern: A brief nonparametric validation (Patell Z + generalized sign) is inserted between the estimation-method description
        and the subgroup comparison tables. This acts as a sanity check before interpreting heterogeneous treatment effects.
      from_slot: R3
      to_slot: ''
      paper_count: 1
      status: EMERGING
      note: Can be adapted to other event-study papers where the primary test is subgroup comparison rather than regression.
    - id: csp_Logit_Probit_Ordered_Probit_R4_57603a3a
      pattern: Subgroup mean comparisons (high reputation vs celebrity vs none) are presented in dedicated tables with paired
        t-tests, rather than embedding interaction terms in a single regression. This is a non-regression approach to testing
        moderation-like predictions.
      from_slot: R4
      to_slot: ''
      paper_count: 1
      status: EMERGING
      note: Applicable when the theory predicts ordinal differences across discrete categories rather than continuous interactions.
    - id: csp_Logit_Probit_Ordered_Probit_R5_5407fc4a
      pattern: Robustness checks include both an alternative estimator (GEE) and an endogeneity correction (Heckman), but
        the authors explicitly note that the GEE regressions do NOT directly test the relative hypotheses. This is an unusual
        and commendable honesty move.
      from_slot: R5
      to_slot: ''
      paper_count: 1
      status: EMERGING
      note: 'Worth emulating: clearly delineate what a robustness check can and cannot speak to.'
    - id: csp_Logit_Probit_Ordered_Probit_R5_8b17b466
      pattern: Heckman correction is justified by referencing Bascle (2008) criteria for estimator selection, and the narrative
        explicitly reports that the selection instrument was insignificant in the second stage, concluding endogeneity is
        not a significant problem.
      from_slot: R5
      to_slot: ''
      paper_count: 1
      status: EMERGING
      note: Provides a template for how to report and interpret a failed/favorable Heckman correction without overclaiming.
    anti_patterns: []
    honesty_boundaries: []
  生存分析:
    display_name: 生存分析 (Survival Analysis / AFT / Cox)
    forced_slots:
    - R1
    - R2
    - R3
    - R7
    high_risk_missing:
      R3: 缺 shape parameter 解释或 hazard ratio 翻译
      R1: 未报告 censoring 比例或生存时间分布
    slots:
      R1:
        skeleton_variants:
        - id: r1_hazard_descriptive_vif
          skeleton: '[R1] 先报告描述性统计与相关性矩阵，随后检查方差膨胀因子（VIF），确认无严重多重共线性，再引入主模型结果。 该骨架适用于 hazard / 计数 / 非线性模型中需要在进入系数表前完成数据质量声明的场景。'
          paper_count: 1
          status: EMERGING
          subfield_distribution:
            om: 1
          sources:
          - Mayo_Ball_Mills_2022_POMS
          transferability: ''
          paradigm_exclusivity: ''
          rhythm_tags: []
          notes: ''
          corpus_path: academic-writing-corpus/生存分析.md
        - id: r1_paragraph_descriptive_vif
          skeleton: '[Descriptive statistics table reference]. [Correlation matrix reference]. [VIF diagnostic report]. [Multicollinearity
            conclusion].'
          skeleton_level: paragraph
          paper_count: 1
          status: EMERGING
          subfield_distribution:
            om: 1
          sources:
          - Mayo_Ball_Mills_2022_POMS
          transferability: ''
          paradigm_exclusivity: ''
          rhythm_tags: []
          notes: ''
          corpus_path: academic-writing-corpus/生存分析.md
        - id: r1_sentence_vif_check
          skeleton: To alleviate multicollinearity concerns, we measure the variance inflation factors (VIFs) and find no
            VIFs greater than [threshold], indicating a low likelihood that multicollinearity is leading to inefficient estimates
            in our regressions.
          skeleton_level: sentence
          paper_count: 1
          status: EMERGING
          subfield_distribution:
            om: 1
          sources:
          - Mayo_Ball_Mills_2022_POMS
          transferability: ''
          paradigm_exclusivity: ''
          rhythm_tags: []
          notes: ''
          corpus_path: academic-writing-corpus/生存分析.md
      R2:
        skeleton_variants:
        - id: r2_main_hazard_exp_interpret
          skeleton: '[R2] 主效应结果：先展示仅含控制变量的基线模型，再展示加入核心自变量后的完整模型。 对 hazard 模型系数采用 exp(β)−1 的方式转化为百分比解释（如“hazard 提高 77%”），并同时报告
            β 与 p 值。 需明确说明参照组（如 middle tertile），并给出方向性结论以支持 H1。'
          paper_count: 1
          status: EMERGING
          subfield_distribution:
            om: 1
          sources:
          - Mayo_Ball_Mills_2022_POMS
          transferability: ''
          paradigm_exclusivity: ''
          rhythm_tags: []
          notes: ''
          corpus_path: academic-writing-corpus/生存分析.md
        - id: r2_paragraph_model_sequence_controls_first
          skeleton: '[Table navigation]. [Controls-only model observation]. [Key control variable directional notes]. [Full
            model introduction].'
          skeleton_level: paragraph
          paper_count: 1
          status: EMERGING
          subfield_distribution:
            om: 1
          sources:
          - Mayo_Ball_Mills_2022_POMS
          transferability: ''
          paradigm_exclusivity: ''
          rhythm_tags: []
          notes: ''
          corpus_path: academic-writing-corpus/生存分析.md
        - id: r2_sentence_controls_direction
          skeleton: We first include all control variables and observe that [control_i] and [control_j] are positively associated
            with the hazard of [DV], while [control_k] and [control_l] are negatively associated with the hazard of [DV].
          skeleton_level: sentence
